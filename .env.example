DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

NEBIUS_API_KEY=your_nebius_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL

# Optional resource search. Set to "tavily" and provide a key to enable it.
RESOURCE_SEARCH_PROVIDER=none
TAVILY_API_KEY=your_tavily_api_key
RESOURCE_PREFERRED_DOMAINS=openstax.org,ocw.mit.edu,khanacademy.org,math.libretexts.org

# PDF extraction uses the NEBIUS_API_KEY, NEBIUS_BASE_URL, and NEBIUS_MODEL above.
PDF_AI_TIMEOUT_SECONDS=60
PDF_MAX_UPLOAD_BYTES=12582912
PDF_MAX_PAGES=12
