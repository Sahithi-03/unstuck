DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

NEBIUS_API_KEY=your_nebius_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=zai-org/GLM-5.3

# Optional resource search. Set to "tavily" and provide a key to enable it.
RESOURCE_SEARCH_PROVIDER=none
TAVILY_API_KEY=your_tavily_api_key
RESOURCE_PREFERRED_DOMAINS=openstax.org,ocw.mit.edu,khanacademy.org,math.libretexts.org
